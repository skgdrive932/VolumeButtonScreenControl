<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F5F5F5">

    <!-- App Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Volume Screen Control"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="32dp"/>

    <!-- Service Status Text -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Service Status: Disabled"
        android:textSize="16sp"
        android:textColor="#D32F2F"
        android:layout_marginBottom="24dp"/>

    <!-- Enable Accessibility Service Button -->
    <Button
        android:id="@+id/btnEnableService"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Accessibility Service"
        android:padding="12dp"
        android:backgroundTint="#1E88E5"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp"/>

    <!-- About Developer Button -->
    <Button
        android:id="@+id/btnAbout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="About Developer"
        android:padding="12dp"
        android:backgroundTint="#424242"
        android:textColor="#FFFFFF"/>

</LinearLayout>
