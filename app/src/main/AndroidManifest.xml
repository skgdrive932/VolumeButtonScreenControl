<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for screen wake functionality -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Required for turning screen on -->
    <uses-permission android:name="android.permission.TURN_SCREEN_ON" />


    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_power"
        android:label="Volume Screen Control"
        android:theme="@style/Theme.VolumeButtonScreenControl">


        <!-- Main application screen -->
        <activity
            android:name="com.example.volumescreencontrol.MainActivity"
            android:exported="true">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>


        <!-- About screen -->
        <activity
            android:name="com.example.volumescreencontrol.AboutActivity"
            android:exported="false" />


        <!--
            Transparent Activity used only to wake
            the device display when Volume Up is pressed.
        -->
        <activity
            android:name="com.example.volumescreencontrol.WakeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/WakeTheme" />


        <!-- Accessibility Service -->
        <service
            android:name="com.example.volumescreencontrol.VolumeAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">

            <intent-filter>

                <action
                    android:name="android.accessibilityservice.AccessibilityService" />

            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />

        </service>

    </application>

</manifest>